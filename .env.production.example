# =============================================================================
# SparkBooks — PRODUCTION environment (books.sparkingasia.com)
# =============================================================================
# This is a REFERENCE. On Forge you paste these into the site's "Environment"
# editor (Forge stores the real .env for you — never commit the real one).
# Fill every <PLACEHOLDER>. Lines marked (later) can be added after go-live.
# -----------------------------------------------------------------------------

APP_NAME=SparkBooks
APP_ENV=production
APP_KEY=                      # leave blank — run `php artisan key:generate` once on the server
APP_DEBUG=false               # NEVER true in production
APP_URL=https://books.sparkingasia.com
APP_TIMEZONE=Asia/Karachi     # PKR business time
APP_LOCALE=en

# --- Database (Forge creates the DB + user when you add the site) ------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sparkbooks
DB_USERNAME=forge
DB_PASSWORD=<DB_PASSWORD_FROM_FORGE>

# --- Sessions / cache / queue (database-backed — no Redis needed) ------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true     # HTTPS-only cookies in production
CACHE_STORE=database
QUEUE_CONNECTION=database       # the queue worker daemon processes these
FILESYSTEM_DISK=local           # attachments live on the private local disk
LOG_CHANNEL=stack
LOG_LEVEL=warning

# --- Mail (sends invoices; §17.6 — the ledger still posts if mail fails) -----
# Use a real sending provider (Postmark / Mailgun / Resend / SES). (later)
MAIL_MAILER=smtp
MAIL_HOST=<SMTP_HOST>
MAIL_PORT=587
MAIL_USERNAME=<SMTP_USER>
MAIL_PASSWORD=<SMTP_PASS>
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=books@sparkingasia.com
MAIL_FROM_NAME="SparkBooks"

# --- Off-site backups (§11) — an S3-compatible bucket (later, before real books)
# e.g. DigitalOcean Spaces / Backblaze B2 / AWS S3. Leaving BACKUP_S3_BUCKET
# blank keeps backups LOCAL-ONLY (inert off-host copy) — safe, but set this
# before running real books so a lost server doesn't lose the data.
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=<REGION>
BACKUP_S3_ENDPOINT=<S3_ENDPOINT_URL>
BACKUP_S3_ACCESS_KEY_ID=<KEY>
BACKUP_S3_SECRET_ACCESS_KEY=<SECRET>
BACKUP_RETENTION_DAILY=14
BACKUP_RETENTION_WEEKLY=8
# On the server, mysqldump/mysql are on PATH after Forge installs MySQL:
BACKUP_MYSQLDUMP_PATH=mysqldump
BACKUP_MYSQL_PATH=mysql

# --- Monitoring & alerts (§17.9) — all optional/inert until set (later) ------
# Error tracking (Sentry free tier):
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=production
# Who gets paged on a backup failure or an integrity finding:
MONITORING_ALERT_EMAIL=you@sparkingasia.com
MONITORING_SLACK_WEBHOOK=
# Dead-man's-switch heartbeats (healthchecks.io URLs — alert on SILENCE):
BACKUP_HEARTBEAT_URL=
INTEGRITY_HEARTBEAT_URL=
QUEUE_HEARTBEAT_URL=

BCRYPT_ROUNDS=12
